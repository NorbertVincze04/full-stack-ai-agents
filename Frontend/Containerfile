FROM docker.io/library/node:22.18.0-alpine AS build

# Build-time proxy only; ARGs of this stage never reach the runtime image.
ARG BUILD_HTTP_PROXY=
ARG BUILD_HTTPS_PROXY=
ARG BUILD_NO_PROXY=localhost,127.0.0.1,db,backend,frontend

ENV NG_CLI_ANALYTICS=false
WORKDIR /app
COPY package.json package-lock.json ./

RUN set -eu; \
    if [ -n "$BUILD_HTTP_PROXY" ]; then export npm_config_proxy="$BUILD_HTTP_PROXY"; fi; \
    if [ -n "$BUILD_HTTPS_PROXY" ]; then export npm_config_https_proxy="$BUILD_HTTPS_PROXY"; fi; \
    export npm_config_noproxy="$BUILD_NO_PROXY"; \
    npm ci --no-audit --no-fund

COPY . .
RUN npm run build

FROM docker.io/library/nginx:1.28.0-alpine AS runtime

RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html

USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
