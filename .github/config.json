{
  "azureDevOps": {
    "organization": "CljP-LOM1-Automation",
    "organizationUrl": "https://dev.azure.com/CljP-LOM1-Automation/",
    "project": "WebTools",
    "taskFilter": {
      "field": "System.Tags",
      "operator": "Contains",
      "value": "deskbookingPrj"
    },
    "doneState": "Done"
  },
  "workflow": {
    "frontendTester": "on-demand",
    "backendTester": "always",
    "backendSecurity": "auto",
    "reviewers": "auto",
    "maxFixIterations": 2,
    "maxTestFixLoops": 2
  },
  "containers": {
    "enabled": true,
    "runtime": "podman",
    "composeFile": "compose.yaml",
    "envFile": ".env",
    "proxy": {
      "hostProxyUrl": "http://127.0.0.1:3128",
      "buildProxyUrl": "http://127.0.0.1:3128",
      "noProxy": "localhost,127.0.0.1,db,backend,frontend"
    },
    "caCertDir": "certs",
    "allowedRegistries": ["docker.io/library", "quay.io", "ghcr.io"]
  },
  "pipelines": {
    "enabled": true,
    "platform": "github-actions",
    "workflowDir": ".github/workflows",
    "ciWorkflow": { "file": "ci.yml", "name": "CI" },
    "cdWorkflow": { "file": "cd.yml", "name": "CD" },
    "branches": { "integration": "dev", "release": "main" },
    "cdMode": "merge-only"
  }
}
