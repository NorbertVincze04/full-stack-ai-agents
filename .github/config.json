{
  "azureDevOps": {
    "organization": "CljP-LOM1-Automation",
    "organizationUrl": "https://dev.azure.com/CljP-LOM1-Automation/",
    "project": "WebTools",
    "taskFilter": {
      "field": "System.Tags",
      "operator": "Contains",
      "value": "deskbookingPrj"
    },
    "doneState": "Done"
  },
  "workflow": {
    "tdd": "always",
    "tddFirst": true,
    "e2e": "auto",
    "security": "auto",
    "reviewers": "auto",
    "maxFixIterations": 2,
    "maxTestFixLoops": 2
  },
  "containers": {
    "enabled": true,
    "runtime": "podman",
    "composeFile": "compose.yaml",
    "envFile": ".env",
    "proxy": {
      "hostProxyUrl": "http://127.0.0.1:3128",
      "buildProxyUrl": "http://127.0.0.1:3128",
      "noProxy": "localhost,127.0.0.1,db,backend,frontend"
    },
    "caCertDir": "certs",
    "allowedRegistries": ["docker.io/library", "quay.io", "ghcr.io"]
  },
  "pipelines": {
    "enabled": true,
    "platform": "github-actions",
    "workflowDir": ".github/workflows",
    "ciWorkflows": [
      { "file": "ci-backend.yml", "name": "CI - Backend Test/Build", "gatesCd": true },
      { "file": "ci-frontend.yml", "name": "CI - Frontend Test/Build", "gatesCd": true },
      { "file": "ci-pr-check.yml", "name": "CI - PR Check", "gatesCd": false }
    ],
    "cdWorkflow": { "file": "cd.yml", "name": "CD - Merge dev into main" },
    "branches": { "integration": "dev", "release": "main" },
    "cdMode": "merge-only"
  },
  "pullRequests": {
    "platform": "github",
    "baseBranch": "dev",
    "branchPrefix": "task/"
  }
}
