# Copy to .env (gitignored) and replace the generated values. Never commit .env.
COMPOSE_PROJECT_NAME=deskbooking

POSTGRES_DB=deskbooking
POSTGRES_USER=deskbooking
# Generate: 32+ hex characters (no URL-special characters, it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=replace-with-generated-hex

# Schema the backend uses for users/bookings inside the container
DB_SCHEMA=ico-env
# Generate: 32+ hex characters
JWT_SECRET=replace-with-generated-hex

# Only published port, bound to 127.0.0.1
FRONTEND_PORT=4200

# Build-time proxy only (credential free build ARGs, never used at runtime)
BUILD_HTTP_PROXY=http://127.0.0.1:3128
BUILD_HTTPS_PROXY=http://127.0.0.1:3128
BUILD_NO_PROXY=localhost,127.0.0.1,db,backend,frontend
