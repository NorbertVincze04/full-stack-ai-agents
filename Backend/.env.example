PORT=3000
# Restrictive default. "*" is only honoured when NODE_ENV is not "production" (local .env only); never use it in a deployment.
CORS_ORIGIN=http://localhost:4200
# Required. Long random string used to sign JWTs (HS256).
JWT_SECRET=
# Optional, default 8h.
JWT_EXPIRES_IN=8h
# Required. PostgreSQL connection string for the ico-env database, e.g. postgresql://user:password@host:5432/ico-env
DATABASE_URL=
# Optional login rate limit (failed attempts per window per IP). Defaults: 10 and 900000 (15 min).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
